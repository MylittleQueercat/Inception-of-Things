# -*- mode: ruby -*-
# vi: set ft=ruby :

LOGIN      = "hguo"
BOX        = "generic/ubuntu2204"
SERVER_IP  = "192.168.56.110"
NETMASK    = "255.255.255.0"

Vagrant.configure("2") do |config|
  # Use the same Ubuntu box for the VM and skip checking for box updates
  # every time `vagrant up` runs.
  config.vm.box = BOX
  config.vm.box_check_update = false

  # Part 2 uses one VM: a K3s server that also runs all three applications.
  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP, netmask: NETMASK

    server.vm.provider "virtualbox" do |vb|
      vb.name = "#{LOGIN}S"
      vb.memory = "1024"
      vb.cpus = 1
    end

    # First install K3s in server mode and tell it which private IP to use.
    server.vm.provision "shell",
      path: "scripts/install_k3s.sh",
      env: { "NODE_IP" => SERVER_IP }

    # Copy the Kubernetes manifests from the host project into the VM.
    # This makes them available to the deployment script below.
    server.vm.provision "file",
      source: "confs",
      destination: "/home/vagrant/confs"

    # Finally wait for the K3s node to become Ready and apply those manifests.
    server.vm.provision "shell",
      path: "scripts/deploy_apps.sh"
  end
end
